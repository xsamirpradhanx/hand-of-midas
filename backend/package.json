{
  "name": "handofmidas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outdir=dist --format=esm --external:@aws-sdk/*",
    "dev": "tsx watch src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ai-quant": "tsx src/scripts/aiQuant.ts",
    "evaluate-quant": "tsx src/scripts/runEvaluateQuant.ts",
    "factor-doctor": "tsx src/scripts/factorDoctor.ts",
    "schwab-auth": "tsx src/scripts/schwabAuthServer.ts",
    "schwab-auth:legacy": "tsx src/scripts/schwab-auth-setup.ts",
    "broker-status": "tsx src/scripts/brokerStatus.ts",
    "backtest": "tsx src/scripts/runBacktest.ts",
    "zone-audit": "tsx src/scripts/zoneAudit.ts",
    "quant-report": "tsx src/scripts/quantReport.ts",
    "rebuild-stats": "tsx src/scripts/rebuildStats.ts",
    "backfill-bars": "tsx src/scripts/backfillBars.ts",
    "capture-intraday": "tsx src/scripts/captureIntradayOnce.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1091.0",
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@aws-sdk/client-ssm": "^3.1090.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1115.0",
    "@google/genai": "^2.12.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.5.0",
    "yahoo-finance2": "^4.0.0"
  }
}
